# =============================================================================
# TeamSpace environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# =============================================================================

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the browser.
# Used for privileged server actions (e.g. inviting members). Optional for v1.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Claude (Anthropic API) ------------------------------------------------
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model. Defaults to claude-opus-4-8.
# For lower cost/latency on a small team you can set claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-opus-4-8

# --- App -------------------------------------------------------------------
# Public base URL, used for OAuth redirects. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Slack (real integration; optional) ------------------------------------
# Incoming webhook URL OR a bot token. The Slack adapter prefers the webhook.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Bot token (xoxb-...) if you'd rather post via chat.postMessage.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#general
# Signing secret — required for inbound slash commands / events
# (/api/slack/commands, /api/slack/events). From the Slack app's Basic Info.
SLACK_SIGNING_SECRET=

# --- Gmail / Google Drive (stubbed in v1) ----------------------------------
# Wire these when you implement the Gmail/Drive adapters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
